from datetime import date, time
from enum import Enum


class Patient:
    def __init__(
        self,
        patient_id: str,
        name: str,
        contact_details: str,
        date_of_birth: date,
    ) -> None:
        if not patient_id:
            raise ValueError("Patient ID is required")
        if not name:
            raise ValueError("Patient name is required")
        if not contact_details:
            raise ValueError("Contact details are required")
        if date_of_birth is None:
            raise ValueError("Date of birth is required")

        self.patient_id: str = patient_id
        self.name: str = name
        self.contact_details: str = contact_details
        self.date_of_birth: date = date_of_birth

    def update_details(
        self,
        name: str,
        contact_details: str,
        date_of_birth: date,
    ) -> None:
        if not name:
            raise ValueError("Patient name is required")
        if not contact_details:
            raise ValueError("Contact details are required")
        if date_of_birth is None:
            raise ValueError("Date of birth is required")

        self.name = name
        self.contact_details = contact_details
        self.date_of_birth = date_of_birth

    def view_history(self) -> list:
        return []

    @staticmethod
    def search(
        patient_id: str,
        name: str,
        date_of_birth: date,
    ) -> list:
        return []


class Practitioner:
    def __init__(
        self,
        practitioner_id: str,
        name: str,
        specialty: str,
        weekly_availability: list[str],
    ) -> None:
        if not practitioner_id:
            raise ValueError("Practitioner ID is required")
        if not name:
            raise ValueError("Practitioner name is required")
        if not specialty:
            raise ValueError("Specialty is required")
        if not weekly_availability:
            raise ValueError("Weekly availability is required")

        self.practitioner_id: str = practitioner_id
        self.name: str = name
        self.specialty: str = specialty
        self.weekly_availability: list[str] = weekly_availability

    def register(self) -> None:
        pass

    def view_schedule(self) -> list:
        return []


class AppointmentStatus(Enum):
    SCHEDULED = "SCHEDULED"
    CANCELLED = "CANCELLED"
    COMPLETED = "COMPLETED"


class Appointment:
    def __init__(
        self,
        appointment_id: str,
        date_of_appointment: date,
        time_of_appointment: time,
        patient: Patient,
        practitioner: Practitioner,
    ) -> None:
        if not appointment_id:
            raise ValueError("Appointment ID is required")
        if date_of_appointment is None:
            raise ValueError("Date is required")
        if time_of_appointment is None:
            raise ValueError("Time is required")
        if patient is None:
            raise ValueError("Appointment must be linked to a patient")
        if practitioner is None:
            raise ValueError("Appointment must be linked to a practitioner")

        self.appointment_id: str = appointment_id
        self.date: date = date_of_appointment
        self.time: time = time_of_appointment
        self.patient: Patient = patient
        self.practitioner: Practitioner = practitioner
        self.__status: AppointmentStatus = AppointmentStatus.SCHEDULED
        self.cancellation_reason: str | None = None

    def cancel(self, reason: str) -> None:
        if self.__status != AppointmentStatus.SCHEDULED:
            raise ValueError(
                f"Cannot cancel an appointment with status {self.__status.value}"
            )
        if not reason:
            raise ValueError("Cancellation reason is required")

        self.__status = AppointmentStatus.CANCELLED
        self.cancellation_reason = reason

    def complete(self) -> None:
        if self.__status != AppointmentStatus.SCHEDULED:
            raise ValueError(
                f"Cannot complete an appointment with status {self.__status.value}"
            )
        self.__status = AppointmentStatus.COMPLETED

    def is_duplicate(
        self,
        practitioner: Practitioner,
        date_of_appointment: date,
        time_of_appointment: time,
    ) -> bool:
        if self.__status != AppointmentStatus.SCHEDULED:
            return False
        return (
            self.practitioner == practitioner
            and self.date == date_of_appointment
            and self.time == time_of_appointment
        )    

    def get_status(self) -> AppointmentStatus:
        return self.__status

def try_book(appointments, appointment_id, date, time, patient, practitioner):
    for existing in appointments:
        if existing.is_duplicate(practitioner, date, time):
            print(f"Rejected {appointment_id}: clashes with {existing.appointment_id}")
            return
    appointments.append(Appointment(appointment_id, date, time, patient, practitioner))
    print(f"Booked {appointment_id}")

def main() -> None:
    print("=== SmartCare Manual Checks ===\n")

    # Create a patient and a practitioner
    patient = Patient("P001", "Jane Smith", "0400 000 000", date(1990, 1, 1))
    doctor = Practitioner("DR01", "Dr Jones", "GP", ["Mon", "Tue", "Wed"])

    appointments = []

    try_book(appointments, "A001", date(2026, 5, 10), time(10, 0), patient, doctor)
    try_book(appointments, "A002", date(2026, 5, 10), time(10, 0), patient, doctor)  # rejected
    try_book(appointments, "A003", date(2026, 5, 10), time(11, 0), patient, doctor)  # booked

    # Cancel the appointment
    appointments[0].cancel("Patient unwell")
    print("Cancelled:", appointments[0].appointment_id, "| status:", appointments[0].get_status().value, "| reason:", appointments[0].cancellation_reason)

    # Attempt an illegal repeated transition
    print("Attempting to cancel the already-cancelled appointment:")
    try:
        appointments[0].cancel("Trying again")
    except ValueError as e:
        print("  Rejected:", e)

    # Update patient details
    patient.update_details("Jane Doe", "0411 222 222", date(1990, 1, 1))
    print("Updated patient:", patient.name, "|", patient.contact_details)

if __name__ == "__main__":
    main()